        {
          "name": "Refuse Appointment",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Non disponible à cette date\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/appointments/1/refuse", "host": ["{{base_url}}"], "path": ["api", "appointments", "1", "refuse"]}
          }
        },
        {
          "name": "Propose Alternative Slot",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduled_at\": \"2026-05-16 15:00:00\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/appointments/1/alternative", "host": ["{{base_url}}"], "path": ["api", "appointments", "1", "alternative"]}
          }
        },
        {
          "name": "Start Appointment",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/appointments/1/start", "host": ["{{base_url}}"], "path": ["api", "appointments", "1", "start"]}
          }
        },
        {
          "name": "Complete Appointment",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/appointments/1/complete", "host": ["{{base_url}}"], "path": ["api", "appointments", "1", "complete"]}
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
