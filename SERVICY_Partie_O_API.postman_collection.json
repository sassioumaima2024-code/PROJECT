            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_id\": 2,\n  \"service_id\": 1,\n  \"scheduled_at\": \"2026-05-15 14:00:00\",\n  \"description\": \"Réparation fuite d'eau\",\n  \"budget\": 100\n}"
            },
            "url": {"raw": "{{base_url}}/api/appointments", "host": ["{{base_url}}"], "path": ["api", "appointments"]}
