{
  "info": {
    "_postman_id": "servicy-part-o-api",
    "name": "SERVICY - Partie O (Prestataire API)",
    "description": "Collection API complète pour la Partie O: Prestataire Mobile + Backend Symfony",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Prestataire",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prestataire@example.tn\",\n  \"password\": \"SecurePassword123\",\n  \"role\": \"prestataire\",\n  \"nom_commercial\": \"Plomberie Pro\",\n  \"phone\": \"+21620000000\",\n  \"gouvernorats\": [\"Tunis\", \"Ariana\"],\n  \"categories\": [\"Plomberie\", \"Électricité\"]\n}"
            },
            "url": {"raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api", "register"]}
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prestataire@example.tn\",\n  \"code\": \"123456\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/verify-otp", "host": ["{{base_url}}"], "path": ["api", "verify-otp"]}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prestataire@example.tn\",\n  \"password\": \"SecurePassword123\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"]}
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/refresh-token", "host": ["{{base_url}}"], "path": ["api", "refresh-token"]}
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "List All Services",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/services?category=Plomberie&gouvernorat=Tunis&price_min=50&price_max=200", "host": ["{{base_url}}"], "path": ["api", "services"], "query": [{"key": "category", "value": "Plomberie"}, {"key": "gouvernorat", "value": "Tunis"}, {"key": "price_min", "value": "50"}, {"key": "price_max", "value": "200"}]}
          }
        },
        {
          "name": "Get Service Details",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/services/1", "host": ["{{base_url}}"], "path": ["api", "services", "1"]}
          }
        },
        {
          "name": "Get My Services",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/provider/services", "host": ["{{base_url}}"], "path": ["api", "provider", "services"]}
          }
        },
        {
          "name": "Create Service",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Réparation Tuyauterie\",\n  \"category\": \"Plomberie\",\n  \"price_min\": 50,\n  \"price_max\": 150,\n  \"experience\": 5,\n  \"description\": \"Réparation et installation tuyauterie professionnelle\",\n  \"governorates\": [\"Tunis\", \"Ariana\"]\n}"
            },
            "url": {"raw": "{{base_url}}/api/provider/services", "host": ["{{base_url}}"], "path": ["api", "provider", "services"]}
          }
        },
        {
          "name": "Update Service",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price_min\": 60,\n  \"price_max\": 180,\n  \"experience\": 6\n}"
            },
            "url": {"raw": "{{base_url}}/api/provider/services/1", "host": ["{{base_url}}"], "path": ["api", "provider", "services", "1"]}
          }
        },
        {
          "name": "Toggle Service Active",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/provider/services/1/toggle", "host": ["{{base_url}}"], "path": ["api", "provider", "services", "1", "toggle"]}
          }
        },
        {
          "name": "Delete Service",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/provider/services/1", "host": ["{{base_url}}"], "path": ["api", "provider", "services", "1"]}
          }
        }
      ]
    },
    {
      "name": "Appointments",
