# Framework
APP_ENV=dev
APP_SECRET=YOUR_APP_SECRET_HERE
APP_SHARE_DIR=var/share

# Routing
DEFAULT_URI=http://localhost:8000

# Database (MySQL)
DATABASE_URL="mysql://root:@127.0.0.1:3306/servicy?serverVersion=8.0.32&charset=utf8mb4"

# JWT Configuration
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=servicy2025
JWT_TOKEN_TTL=3600

# Messenger (Async Tasks)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailer (Email)
MAILER_DSN=smtp://user:pass@smtp.example.com:587?encryption=tls
# For development/testing: MAILER_DSN=null://null

# CORS Configuration
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|10\.0\.2\.2)(:[0-9]+)?$'

# Firebase FCM (Optional - for push notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# Google Maps API (Optional - for GPS/ETA)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Twilio (Optional - for SMS OTP)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
